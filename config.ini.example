[SMTP]
host = mail.example.com
port = 587
username = your_mail@example.com
password = your_mail_password
use_tls = True
use_ssl = False

[SENDER]
name = Sendora Lite
email = your_email@example.com

[EMAIL_CONTENT]
subject = Notification from Sendora Lite
mode = html
html_path = uploads/templates/default.html
plain_path = uploads/templates/default.txt

[SETTINGS]
concurrency_limit = 5
max_retries = 3
retry_delay = 5
timeout = 30
log_level = INFO
log_file = logs/mailer.log